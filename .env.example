# =============================================================================
# Codario Labs — SEO Report Generator
# Copia este archivo a `.env` y completa los valores. Nunca subas `.env` al repositorio.
# Genera secretos con:  openssl rand -base64 32   (o el comando Node indicado en cada caso)
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación
# -----------------------------------------------------------------------------
# URL pública desde la que se abre el panel (frontend). Se usa para redirecciones OAuth y CORS.
APP_URL=http://localhost:8080
# Puerto del host donde se publica el frontend (nginx) con Docker Compose.
FRONTEND_PORT=8080
# Orígenes permitidos (CORS + verificación de Origin en peticiones mutantes), separados por comas.
# Incluye el servidor de desarrollo de Vite si trabajas fuera de Docker.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Zona horaria por defecto (IANA) para calcular "hoy" y los periodos. Editable luego en Settings.
APP_TIMEZONE=America/Bogota
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Acceso privado al panel (app single-user, sin registro ni login de usuarios)
# -----------------------------------------------------------------------------
# Clave para desbloquear el panel (mínimo 12 caracteres). Compártela solo con quien deba usar la app.
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
APP_ACCESS_KEY=
# Secreto para firmar la cookie de sesión del panel (mínimo 32 caracteres).
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Duración de la sesión del panel en horas.
SESSION_TTL_HOURS=12

# -----------------------------------------------------------------------------
# PostgreSQL / Prisma
# -----------------------------------------------------------------------------
POSTGRES_USER=codario
# Usa solo letras y números (se interpola en DATABASE_URL).
POSTGRES_PASSWORD=
POSTGRES_DB=seo_reports
# Puerto expuesto SOLO en 127.0.0.1 para desarrollo local (migraciones, Prisma Studio).
POSTGRES_HOST_PORT=5434
# Para ejecutar el backend fuera de Docker (npm run dev:backend). Dentro de Docker se construye automáticamente.
DATABASE_URL=postgresql://codario:CHANGE_ME@localhost:5434/seo_reports?schema=public

# -----------------------------------------------------------------------------
# Cifrado de tokens OAuth en reposo (AES-256-GCM)
# -----------------------------------------------------------------------------
# 32 bytes en base64. ¡Si lo cambias, deberás volver a conectar Google!
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Google OAuth 2.0 + Search Console API (ver README → "Configurar Google Cloud")
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Debe coincidir EXACTAMENTE con un "Authorized redirect URI" del cliente OAuth en Google Cloud.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
# Máximo de filas por dimensión (consultas/páginas) a descargar de GSC por periodo (paginación de 25.000).
GSC_MAX_ROWS_PER_DIMENSION=5000

# -----------------------------------------------------------------------------
# Anthropic API (análisis SEO con IA). Solo se usa en el backend; nunca llega al navegador.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_OUTPUT_TOKENS=64000
ANTHROPIC_TIMEOUT_MS=600000
ANTHROPIC_MAX_RETRIES=3
# Reintento del lado del servidor con un modelo alternativo si el modelo principal declina la petición.
ANTHROPIC_ENABLE_FALLBACK=true

# -----------------------------------------------------------------------------
# Almacenamiento y branding
# -----------------------------------------------------------------------------
# Directorio persistente para PDFs y logos (en Docker es un volumen: /data/storage).
STORAGE_DIR=./storage
# Logo oficial de Codario Labs (opcional). Coloca el archivo en ./branding/ y apunta aquí.
# En Docker la carpeta ./branding se monta en /app/branding (solo lectura).
# También puedes subirlo desde Settings en el panel (tiene prioridad sobre este archivo).
CODARIO_LOGO_PATH=

# -----------------------------------------------------------------------------
# Generación de reportes
# -----------------------------------------------------------------------------
# Reportes que se procesan en paralelo.
REPORT_WORKER_CONCURRENCY=1
# Tiempo máximo de una generación completa (ms).
REPORT_JOB_TIMEOUT_MS=900000
